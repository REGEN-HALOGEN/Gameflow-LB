# ---- Build stage ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
# Cache dependencies first
RUN mvn -q -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

# ---- Runtime stage ----
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/gameflow-lb-*.jar app.jar
# Allow RMI stubs to resolve the host correctly inside containers
ENV JAVA_RMI_SERVER_HOSTNAME=127.0.0.1
EXPOSE 8080 1099
ENTRYPOINT ["sh", "-c", "java -Djava.rmi.server.hostname=${JAVA_RMI_SERVER_HOSTNAME} -jar app.jar"]
