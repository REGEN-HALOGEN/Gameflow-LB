# Copy to .env and adjust for your machine. Never commit real secrets.
# Backend port
BACKEND_PORT=8080
# RMI registry port (game servers bind here)
RMI_PORT=1099
# Frontend dev server port
FRONTEND_PORT=5173
# Optional overrides used by the frontend build (defaults are same-origin relative paths)
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080
